{
  "manifest_version": 3,
  "name": "Jarvis for Browser",
  "version": "0.1.0",
  "description": "AI agent that plans and executes multi-step actions on live web pages via voice, text, paste, or image.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Jarvis"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
